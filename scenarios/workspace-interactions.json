          "description": "Click Search button in invoice search section using evaluate"
        },
        {
          "type": "wait-for-selector",
          "selector": "table tbody tr",
          "timeoutMs": 10000,
          "description": "Wait for invoice search results to load"
        },
        {
          "type": "click",
          "selector": "table tbody tr:first-child",
          "description": "Click first row in invoice search results table"
        },
