        {
          "type": "click",
          "selector": "button.btn-success.ng-binding",
          "description": "Click Search button in Search invoices widget"
        },
        {
          "type": "wait-for-selector",
          "selector": "table.bodyTable.gridTable tbody tr",
          "timeoutMs": 10000,
          "description": "Wait for invoice search results to load"
        },
        {
          "type": "click",
          "selector": "table.bodyTable.gridTable tbody tr:first-child",
          "description": "Click first row in invoice search results grid"
        },
        {
          "type": "wait-for-selector",
          "selector": "#invoiceDetails tbody tr",
          "timeoutMs": 10000,
          "description": "Wait for invoice information to load in Invoice details widget"
        }
      ]
    }
  ]
